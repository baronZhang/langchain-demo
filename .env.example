# =====================================================================
# langchain-demo 环境变量模板
# 用法：cp .env.example .env，然后填入真实值（.env 已被 .gitignore 忽略）
# =====================================================================

# ---------- 1. 对话模型（必填） ----------
# LLM_PROVIDER 决定走哪种协议，取值即 init_chat_model 的 model_provider：
#   anthropic : Anthropic Messages 协议（火山方舟 Coding Plan / 智谱 / Kimi 等都提供兼容端点）
#   openai    : OpenAI Chat Completions 协议（几乎所有国产模型都兼容）
LLM_PROVIDER=anthropic

# Anthropic 协议的 base_url 不带 /v1（SDK 会自动拼 /v1/messages）
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/coding
# 若改用 OpenAI 协议：LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v3

LLM_API_KEY=your-api-key-here

# 主模型：复杂推理、Agent 主循环
LLM_MODEL=glm-latest
# 快模型：摘要、工具筛选、兜底等“辅助活”，越快越便宜越好
LLM_FAST_MODEL=deepseek-v4-flash

# 推理模型会先输出 thinking 再输出正文，max_tokens 要留足
LLM_MAX_TOKENS=8192
LLM_TIMEOUT=180

# ---------- 2. 向量模型（可选） ----------
# local  : 内置的字符 n-gram 哈希向量（零依赖、零下载，适合离线演示，语义能力有限）
# openai : 任意 OpenAI 兼容的 /embeddings 接口（百炼 text-embedding-v4、智谱 embedding-3、Ollama 等）
EMBEDDING_PROVIDER=local
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# ---------- 3. LangSmith 可观测性（可选） ----------
# 打开后所有 LangChain/LangGraph 调用自动上报 trace，无需改代码
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=langchain-demo
# 国内网络或私有化部署可改 endpoint
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
